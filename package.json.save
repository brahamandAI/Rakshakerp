{
  "name": "rakshak-eoms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "prebuild": "npm run clean",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start-prod.js",
    "lint": "next lint",
"db:check": "tsx --env-file=.env scripts/check-db.ts"    
db:check": "tsx --env-file=.env.local scripts/check-db.ts",
    "db:ip": "tsx scripts/show-atlas-ip.ts",
    "seed": "tsx --env-file=.env.local scripts/seed/users.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mongoose": "^8.9.0",
    "multer": "^2.2.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.19.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
